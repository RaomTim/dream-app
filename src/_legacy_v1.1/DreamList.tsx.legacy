'use client'

import { useState } from 'react'

type Entry = {
  id: string
  title: string | null
  raw_text: string
  created_at: string
  mood: string | null
  prophetic_suspect: boolean
  entry_type: string
}

type Props = {
  entries: Entry[]
  onSelect: (id: string, entryType?: string) => void
  onNewEntry: () => void
}

const TYPE_CONFIG: Record<string, { emoji: string; label: string; color: string }> = {
  dream: { emoji: '🌙', label: 'Rêve', color: '#6366f1' },
  day: { emoji: '📝', label: 'Journal', color: '#818cf8' },
  oracle: { emoji: '🃏', label: 'Oracle', color: '#a78bfa' },
  tale: { emoji: '🔥', label: 'Conte', color: '#f59e0b' },
  forest: { emoji: '🌲', label: 'Forêt', color: '#22c55e' },
  reentry: { emoji: '🌀', label: 'Réentrée', color: '#6366f1' },
}

export default function DreamList({ entries, onSelect, onNewEntry }: Props) {
  const [filter, setFilter] = useState<string | null>(null)

  const filteredEntries = filter
    ? entries.filter((e) => (e.entry_type || 'dream') === filter)
    : entries

  const formatDate = (dateStr: string) => {
    const date = new Date(dateStr)
    const now = new Date()
    const diff = now.getTime() - date.getTime()
    const days = Math.floor(diff / (1000 * 60 * 60 * 24))

    if (days === 0) return "Aujourd'hui"
    if (days === 1) return 'Hier'
    if (days < 7) return `Il y a ${days} jours`
    return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })
  }

  return (
    <div className="h-full overflow-y-auto">
      {/* Bouton nouvelle entrée */}
      <div className="p-4">
        <button
          onClick={onNewEntry}
          className="w-full py-3 rounded-xl bg-[#6366f1] text-white font-medium text-sm hover:bg-[#5558e6] transition-colors flex items-center justify-center gap-2"
        >
          Nouvelle entrée
        </button>
      </div>

      {/* Filtres par type */}
      <div className="flex gap-1 px-4 pb-3 overflow-x-auto">
        <button
          onClick={() => setFilter(null)}
          className={`px-3 py-1 rounded-full text-xs whitespace-nowrap transition-colors shrink-0 ${
            filter === null
              ? 'bg-[#6366f1] text-white'
              : 'bg-[#12122a] text-[#94a3b8] border border-[#2a2a4a]'
          }`}
        >
          Tout
        </button>
        {Object.entries(TYPE_CONFIG).map(([key, cfg]) => (
          <button
            key={key}
            onClick={() => setFilter(key)}
            className={`px-3 py-1 rounded-full text-xs whitespace-nowrap transition-colors shrink-0 ${
              filter === key
                ? 'text-white'
                : 'bg-[#12122a] text-[#94a3b8] border border-[#2a2a4a]'
            }`}
            style={filter === key ? { backgroundColor: cfg.color } : undefined}
          >
            {cfg.emoji} {cfg.label}
          </button>
        ))}
      </div>

      {/* Liste */}
      <div className="px-4 space-y-2 pb-4">
        {filteredEntries.length === 0 && (
          <p className="text-center text-[#64748b] text-sm py-8">
            {filter ? `Aucune entrée "${TYPE_CONFIG[filter]?.label}" pour l'instant.` : 'Aucune entrée. Commence ton journal.'}
          </p>
        )}

        {filteredEntries.map((entry) => {
          const type = TYPE_CONFIG[entry.entry_type || 'dream'] || TYPE_CONFIG.dream
          return (
            <button
              key={entry.id}
              onClick={() => onSelect(entry.id, entry.entry_type)}
              className="w-full text-left p-4 rounded-xl bg-[#12122a] border border-[#2a2a4a] hover:border-[#6366f1] transition-colors"
            >
              <div className="flex items-start justify-between gap-2">
                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-sm">{type.emoji}</span>
                    <span className="text-xs font-medium" style={{ color: type.color }}>
                      {type.label}
                    </span>
                  </div>
                  <p className="text-sm text-[#e2e8f0] truncate">
                    {entry.title || entry.raw_text.substring(0, 60) + (entry.raw_text.length > 60 ? '...' : '')}
                  </p>
                  <p className="text-xs text-[#64748b] mt-1">
                    {formatDate(entry.created_at)}
                    {entry.mood && ` — ${entry.mood}`}
                  </p>
                </div>
                {entry.prophetic_suspect && (
                  <span className="text-xs bg-[#eab308]/20 text-[#eab308] px-2 py-0.5 rounded-full shrink-0">
                    prophétique ?
                  </span>
                )}
              </div>
            </button>
          )
        })}
      </div>
    </div>
  )
}
